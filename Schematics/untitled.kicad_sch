	(text_box "DESIGN NOTE:\nVoltage divider output = VIN1_THRESHOLD\nVIN1_THRESHOLD = 0.5 x 3V3_LDO\nif VIN1_THRESHOLD ≥ 1V, VIN output.\nie, if 3V3_LDO ≥ 2V, VIN output.\n"
		(exclude_from_sim no)
		(at 94.615 142.875 0)
