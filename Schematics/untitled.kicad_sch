	(text_box "DESIGN NOTE:\nPower multiplexer in priority mode.\nSelects VIN1 if:\n	VIN1 ≥ 2V, whether or not VIN2 is present\nSelects VIN2 if\n	VIN2 present & VIN1 < 2V"
		(exclude_from_sim no)
